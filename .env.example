# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF
# ID администраторов через запятую
ADMIN_IDS=123456789
# База данных (sqlite по умолчанию; для PostgreSQL: postgresql+asyncpg://user:pass@host/db)
DATABASE_URL=sqlite+aiosqlite:///data/bot.db
# Данные приложения my.telegram.org для пула сессий Telethon (папка sessions/)
API_ID=0
API_HASH=
SESSIONS_DIR=sessions
# Tgrass (можно задать и поменять позже через /admin)
TGRASS_API_KEY=
# Интервал проверки ловушек (сек)
SNIPER_INTERVAL=120
# Необязательный HTTP-прокси для запросов к Fragment / t.me
HTTP_PROXY=
# Оплата в долларах: токен Crypto Pay (@CryptoBot -> Crypto Pay -> Мои приложения)
CRYPTOBOT_TOKEN=
# Токен xRocket Pay API (@xRocket -> Pay API -> приложение -> Settings -> API Token)
XROCKET_TOKEN=
