# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF
# ID администраторов через запятую
ADMIN_IDS=123456789
# Папка для файлов бота (база SQLite, сессия бота). На хостинге — та, что не стирается
# при перезапуске (на Bothost: /app/data)
DATA_DIR=data
# База данных: пусто — SQLite в DATA_DIR/bot.db; для PostgreSQL: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=
# Данные приложения my.telegram.org для пула аккаунтов Telethon (аккаунты хранятся в БД)
API_ID=0
API_HASH=
# Отсюда при запуске один раз импортируются старые .session-файлы
SESSIONS_DIR=sessions
# Tgrass (можно задать и поменять позже через /admin)
TGRASS_API_KEY=
# Интервал проверки ловушек (сек)
SNIPER_INTERVAL=120
# Необязательный HTTP-прокси для запросов к Fragment / t.me
HTTP_PROXY=
# Оплата в долларах: токен Crypto Pay (@CryptoBot -> Crypto Pay -> Мои приложения)
CRYPTOBOT_TOKEN=
# Токен xRocket Pay API (@xRocket -> Pay API -> приложение -> Settings -> API Token)
XROCKET_TOKEN=
